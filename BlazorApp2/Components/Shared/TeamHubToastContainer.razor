@* Components/Shared/TeamHubToastContainer.razor
   Real-time toast stack for the Team Portal.
   Mirrors BlazorApp2.Components.Shared.HubToastContainer (admin side) —
   subscribes directly to TeamHubService events instead of going through
   NotificationState, so it reacts the instant SignalR pushes an event,
   independent of whatever page is currently on screen.

   Drop at: Components/Shared/TeamHubToastContainer.razor
   Rendered once from TeamLayout.razor (leader-only), so it persists
   across navigation within the team portal — same lifetime as the hub
   connection itself.
*@
@inject BlazorApp2.Services.TeamHubService TeamHub
@inject NavigationManager Nav
@implements IDisposable

@if (_toasts.Count > 0)
{
    <div class="team-rt-toast-stack">
        @foreach (var toast in _toasts)
        {
            var t = toast; // capture for lambda
            <div class="team-rt-toast team-rt-toast--@t.Kind" @key="t.Id" @onclick="() => HandleToastClick(t)">
                <div class="team-rt-toast-icon">
                    <i class="fa-solid @IconFor(t.Kind)"></i>
                </div>
                <div class="team-rt-toast-body">
                    <div class="team-rt-toast-title">@TitleFor(t.Kind)</div>
                    <div class="team-rt-toast-msg">@t.Message</div>
                </div>
                <button class="team-rt-toast-close" @onclick="() => Dismiss(t.Id)" @onclick:stopPropagation="true">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }
    </div>
}

@code {
    private readonly List<RtToast> _toasts = new();
    private int _nextId = 1;

    protected override void OnInitialized()
    {
        TeamHub.OnTeamAssignedToDisaster += HandleTeamAssigned;
    }

    // ── Hub handler — fires on the SignalR thread, so hop back via InvokeAsync ──
    private Task HandleTeamAssigned(Services.TeamAssignedEvent e)
    {
        return InvokeAsync(() =>
        {
            var toast = new RtToast(
                _nextId++,
                "assignment",
                $"{e.Title} — {e.City}",
                e.ReferenceId,
                e.TeamId,
                6000);

            _toasts.Add(toast);
            StateHasChanged();

            ScheduleDismiss(toast.Id, toast.DurationMs);
        });
    }

    private void ScheduleDismiss(int id, int durationMs)
    {
        _ = Task.Delay(durationMs).ContinueWith(_ =>
        {
            InvokeAsync(() => Dismiss(id));
        });
    }

    private void Dismiss(int id)
    {
        _toasts.RemoveAll(t => t.Id == id);
        StateHasChanged();
    }

    private void HandleToastClick(RtToast t)
    {
        Dismiss(t.Id);
        Nav.NavigateTo("/team/disaster");
    }

    private static string IconFor(string kind) => kind switch
    {
        "assignment" => "fa-fire",
        _ => "fa-circle-info"
    };

    private static string TitleFor(string kind) => kind switch
    {
        "assignment" => "New Assignment",
        _ => "Notification"
    };

    public void Dispose()
    {
        TeamHub.OnTeamAssignedToDisaster -= HandleTeamAssigned;
    }

    private record RtToast(
        int Id,
        string Kind,
        string Message,
        string ReferenceId,
        Guid TeamId,
        int DurationMs);
}
