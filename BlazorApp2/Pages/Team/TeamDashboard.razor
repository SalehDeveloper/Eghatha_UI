@page "/team"
@layout TeamLayout
@using BlazorApp2.Services
@using BlazorApp2.Responses
@inject ServiceApi Api
@inject NavigationManager Nav
@inject TeamHubService HubService
@implements IAsyncDisposable

<div class="tdash-page">

    <div class="tdash-header">
        <h1 class="tdash-title">
            <i class="fa-solid fa-house"></i>
            Dashboard
        </h1>
        <div class="tdash-header-right">
            <span class="tdash-live-indicator">
                <span class="tdash-pulse"></span>Live
            </span>
            <span class="tdash-role-badge @(_isLeader ? "tdash-role-badge--leader" : "")">
                <i class="fa-solid @(_isLeader ? "fa-star" : "fa-user")"></i>
                @(_isLeader ? "Team Leader" : "Team Member")
            </span>
        </div>
    </div>

    @if (_loading)
    {
        <div class="tdash-loading">
            <span class="spinner"></span>
            <span>Loading dashboard…</span>
        </div>
    }
    else if (_error is not null)
    {
        <div class="tdash-error">
            <i class="fa-solid fa-triangle-exclamation"></i>
            @_error
        </div>
    }
    else
    {
        <!-- ── Summary cards ── -->
        <div class="tdash-cards">
            <div class="tdash-card">
                <div class="tdash-card-icon tdash-card-icon--team">
                    <i class="fa-solid fa-people-group"></i>
                </div>
                <div class="tdash-card-body">
                    <div class="tdash-card-label">Team Status</div>
                    <div class="tdash-card-value">@(_teamInfo?.Status ?? "—")</div>
                </div>
            </div>

            <div class="tdash-card">
                <div class="tdash-card-icon tdash-card-icon--members">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div class="tdash-card-body">
                    <div class="tdash-card-label">Active Members</div>
                    <div class="tdash-card-value">@(_teamInfo?.ActiveMembersCount ?? 0) / @(_teamInfo?.MembersCount ?? 0)</div>
                </div>
            </div>

            <div class="tdash-card">
                <div class="tdash-card-icon tdash-card-icon--resources">
                    <i class="fa-solid fa-box-open"></i>
                </div>
                <div class="tdash-card-body">
                    <div class="tdash-card-label">Resources</div>
                    <div class="tdash-card-value">@_resourceCount items</div>
                </div>
            </div>

            @if (_assignedDisaster is not null)
            {
                <div class="tdash-card tdash-card--alert" @onclick='() => Nav.NavigateTo($"/team/disasters/{_assignedDisaster.DisasterId}")'>
                    <div class="tdash-card-icon tdash-card-icon--disaster">
                        <i class="fa-solid fa-fire"></i>
                    </div>
                    <div class="tdash-card-body">
                        <div class="tdash-card-label">Active Disaster</div>
                        <div class="tdash-card-value tdash-card-value--sm">@_assignedDisaster.Title</div>
                        <div class="tdash-card-sub">@_assignedDisaster.City, @_assignedDisaster.Province</div>
                    </div>
                    <i class="fa-solid fa-chevron-right tdash-card-arrow"></i>
                </div>
            }
            else
            {
                <div class="tdash-card">
                    <div class="tdash-card-icon tdash-card-icon--idle">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div class="tdash-card-body">
                        <div class="tdash-card-label">Active Disaster</div>
                        <div class="tdash-card-value" style="color:var(--color-success)">No active mission</div>
                    </div>
                </div>
            }
        </div>

        @* ── Team status — separate from any single disaster, so a team can be
             corrected here even if its last disaster was archived while the
             team status was still "Returning". ── *@
        @if (_isLeader && _teamInfo is not null && (_teamInfo.Status == "OnMission" || _teamInfo.Status == "Returning"))
        {
            <div class="tdash-quick-links">
                <h2 class="tdash-section-title">Team Status</h2>
                <div class="tdash-links-grid">
                    <span class="tdash-role-badge">Current: @_teamInfo.Status</span>
                    @if (_teamInfo.Status == "OnMission")
                    {
                        <button class="tdash-link" @onclick='() => SetTeamStatusAsync("returning")' disabled="@_statusBusy">
                            @if (_statusBusy)
                            {
                                <span class="spinner spinner-sm"></span>
                            }
                            else
                            {

                                <i class="fa-solid fa-rotate-left"></i>
                            }
                            <span>Set Returning</span>
                        </button>
                    }
                    else
                    {
                        <button class="tdash-link" @onclick='() => SetTeamStatusAsync("active")' disabled="@_statusBusy">
                            @if (_statusBusy)
                            {
                                <span class="spinner spinner-sm"></span>
                            }
                            else
                            {

                                <i class="fa-solid fa-play"></i>
                            }
                            <span>Set Active</span>
                        </button>
                    }
                    @if (_statusMessage is not null)
                    {
                        <span style="font-size:13px;color:@(_statusOk ? "var(--color-success)" : "var(--color-critical)")">
                            @_statusMessage
                        </span>
                    }
                </div>
            </div>
        }

        <!-- ── Quick links ── -->
        <div class="tdash-quick-links">
            <h2 class="tdash-section-title">Quick Links</h2>
            <div class="tdash-links-grid">
                @if (_assignedDisaster is not null)
                {
                    <a class="tdash-link" href="/team/disaster">
                        <i class="fa-solid fa-fire"></i>
                        <span>Disaster Details</span>
                    </a>
                }
                <a class="tdash-link" href="/team/info">
                    <i class="fa-solid fa-people-group"></i>
                    <span>Team Info</span>
                </a>
                <a class="tdash-link" href="/team/resources">
                    <i class="fa-solid fa-box-open"></i>
                    <span>Resources</span>
                </a>
                @if (_isLeader)
                {
                    <a class="tdash-link" href="/team/notifications">
                        <i class="fa-solid fa-bell"></i>
                        <span>Notifications</span>
                    </a>
                }
            </div>
        </div>
    }

</div>

@code {
    private bool _loading = true;
    private string? _error;
    private bool _isLeader;
    private TeamResponse? _teamInfo;
    private TeamDisasterResponse? _assignedDisaster;
    private int _resourceCount;
    private Guid _teamId;
    private bool _statusBusy;
    private string? _statusMessage;
    private bool _statusOk;

    protected override async Task OnInitializedAsync()
    {
        HubService.OnTeamAssignedToDisaster += HandleTeamAssigned;

        var meResult = await Api.GetCurrentTeamMemberInfoAsync();
        if (!meResult.IsSuccess || meResult.Data is null)
        {
            _error = "Could not load your team information.";
            _loading = false;
            return;
        }

        _isLeader = meResult.Data.IsLeader;
        _teamId = meResult.Data.TeamId;

        // Load team details and assigned disaster in parallel
        var teamTask = Api.GetTeamByIdAsync(_teamId);
        var disasterTask = Api.GetTeamDisasters(_teamId, 1, 1);
        var resourceTask = Api.GetTeamResourcesAsync(_teamId, 1, 1);

        await Task.WhenAll(teamTask, disasterTask, resourceTask);

        var teamResult = await teamTask;
        if (teamResult.IsSuccess) _teamInfo = teamResult.Data;

        var disasterResult = await disasterTask;
        if (disasterResult.IsSuccess && disasterResult.Data?.Items.Count > 0)
        {
            var latest = disasterResult.Data.Items.First();
            // Only show if active (not closed)
            if (latest.Status != "Closed")
                _assignedDisaster = latest;
        }

        var resResult = await resourceTask;
        if (resResult.IsSuccess)
            _resourceCount = resResult.Data?.TotalCount ?? 0;

        _loading = false;
    }

    // ── Real-time: refresh the "active disaster" card the instant
    //    this team gets assigned, without waiting for a page reload.
    //    The toast itself is handled separately by TeamHubToastContainer
    //    (rendered once from TeamLayout) — this just keeps THIS page's
    //    local state in sync if it happens to be open.
    private async Task HandleTeamAssigned(Services.TeamAssignedEvent e)
    {
        if (e.TeamId != _teamId) return; // event is broadcast hub-wide; filter to our team

        var disasterTask = Api.GetTeamDisasters(_teamId, 1, 1);
        var disasterResult = await disasterTask;
        if (disasterResult.IsSuccess && disasterResult.Data?.Items.Count > 0)
        {
            var latest = disasterResult.Data.Items.First();
            if (latest.Status != "Closed")
                _assignedDisaster = latest;
        }

        await InvokeAsync(StateHasChanged);
    }

    // Lets a leader correct the team's status directly, independent of any
    // single disaster — needed because the only other place to change it
    // (TeamDisasterDetail) can become unreachable once that disaster is
    // Archived, leaving a team stuck on "Returning" with no way back to "Active".
    private async Task SetTeamStatusAsync(string newStatus)
    {
        _statusBusy = true;
        _statusMessage = null;
        StateHasChanged();

        var result = newStatus == "returning"
            ? await Api.ReturningTeamAsync(_teamId)
            : await Api.ActivateTeamAsync(_teamId);

        _statusOk = result.IsSuccess;

        if (result.IsSuccess)
        {
            var teamResult = await Api.GetTeamByIdAsync(_teamId);
            if (teamResult.IsSuccess && teamResult.Data is not null)
                _teamInfo = teamResult.Data;
            _statusMessage = "Status updated.";
        }
        else
        {
            _statusMessage = result.ErrorDetail ?? "Failed to update team status.";
        }

        _statusBusy = false;
    }

    public ValueTask DisposeAsync()
    {
        HubService.OnTeamAssignedToDisaster -= HandleTeamAssigned;
        return ValueTask.CompletedTask;
    }
}
