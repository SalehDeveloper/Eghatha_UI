@page "/forgot-password"
@layout EmptyLayout
@inject BlazorApp2.Services.ServiceApi ServiceApi
@inject NavigationManager Navigation
@using BlazorApp2.Requests

<div class="reset-page">

    <div class="reset-card">

        <div class="logo-section">
            <div class="logo-circle">
                🔐
            </div>

            <h1>Password Recovery</h1>

            @if (CurrentStep == 1)
            {
                <p>
                    Enter your email address and we'll send you
                    an 8-digit verification code.
                </p>
            }
            else
            {
                <p>
                    Enter the verification code and choose a new password.
                </p>
            }
        </div>

        @if (CurrentStep == 1)
        {
            <EditForm Model="@RequestModel"
                      OnValidSubmit="SendResetCode">

                <DataAnnotationsValidator />

                <div class="field">
                    <label>Email Address</label>

                    <InputText class="input"
                               @bind-Value="RequestModel.Email"
                               placeholder="example@eghatha.com" />

                    <ValidationMessage For="() => RequestModel.Email" />
                </div>

                <button class="primary-btn">
                    Send Verification Code
                </button>

            </EditForm>
        }

        @if (CurrentStep == 2)
        {
            <EditForm Model="@ResetModel"
                      OnValidSubmit="ResetPassword">

                <DataAnnotationsValidator />

                <div class="field">
                    <label>Verification Code</label>

                    <InputText class="input code-input"
                               maxlength="8"
                               @bind-Value="ResetModel.Code"
                               placeholder="12345678" />
                </div>

                <div class="field">
                    <label>New Password</label>

                    <InputText type="password"
                               class="input"
                               @bind-Value="ResetModel.NewPassword" />
                </div>

                <div class="field">
                    <label>Confirm Password</label>

                    <InputText type="password"
                               class="input"
                               @bind-Value="ConfirmPassword" />
                </div>

                <button class="primary-btn">
                    Reset Password
                </button>

            </EditForm>
        }

        @if (CurrentStep == 3)
        {
            <div class="success-state">

                <div class="success-icon">
                    ✓
                </div>

                <h2>Password Updated</h2>

                <p>
                    Your password has been changed successfully.
                </p>

                <button class="primary-btn"
                        @onclick="GoToLogin">
                    Return to Login
                </button>

            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="error-banner">
                @Error
            </div>
        }

        <a href="/login" class="back-link">
            ← Back to Login
        </a>

    </div>

</div>

@code{
    private int CurrentStep = 1;

    private string Error = "";

    private string ConfirmPassword = "";

    private RequestResetModel RequestModel = new();

    private ResetPasswordRequest ResetModel = new();

    private async Task SendResetCode()
    {
        Error = "";

        var result =
            await ServiceApi.RequestPasswordResetAsync(
                RequestModel);

        if (result.IsSuccess)
        {
            ResetModel.Email = RequestModel.Email;

            CurrentStep = 2;

            StateHasChanged();
        }
        else
        {
            Error = result.ErrorDetail;
            StateHasChanged();
        }
    }

    private async Task ResetPassword()
    {
        Error = "";

        if (ConfirmPassword != ResetModel.NewPassword)
        {
            Error = "Passwords do not match.";
            StateHasChanged();
            return;
        }

        var result =
            await ServiceApi.ResetPasswordAsync(ResetModel);

        if (result.IsSuccess)
        {
            CurrentStep = 3;
            StateHasChanged();
        }
        else
        {
            Error = result.ErrorDetail;
            StateHasChanged();
        }
}

private void GoToLogin()
{
    Navigation.NavigateTo("/login");
}
    }