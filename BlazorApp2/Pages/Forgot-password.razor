@page "/forgot-password"
@layout EmptyLayout
@inject BlazorApp2.Services.ServiceApi ServiceApi
@inject NavigationManager Navigation
@using BlazorApp2.Requests

<div class="reset-page">
    <div class="reset-card">

        <!-- Header -->
        <div class="logo-section">
            <div class="logo-circle">🔐</div>
            <h1>Password Recovery</h1>
            @if (CurrentStep == 1)
            {
                <p>Enter your email address and we'll send you an 8-digit verification code.</p>
            }
            else if (CurrentStep == 2)
            {
                <p>Enter the verification code sent to <strong>@RequestModel.Email</strong> and choose a new password.</p>
            }
        </div>

        <!-- Step indicator -->
        @if (CurrentStep == 1 || CurrentStep == 2)
        {
            <div class="step-indicator">
                <div class="step @(CurrentStep >= 1 ? "active" : "") @(CurrentStep > 1 ? "done" : "")">
                    <span class="step-dot">@(CurrentStep > 1 ? "✓" : "1")</span>
                    <span class="step-label">Email</span>
                </div>
                <div class="step-line @(CurrentStep > 1 ? "done" : "")"></div>
                <div class="step @(CurrentStep >= 2 ? "active" : "")">
                    <span class="step-dot">2</span>
                    <span class="step-label">Reset</span>
                </div>
            </div>
        }

        <!-- Step 1: Email -->
        @if (CurrentStep == 1)
        {
            <EditForm Model="@RequestModel" OnValidSubmit="SendResetCode" class="reset-form">
                <DataAnnotationsValidator />

                <div class="field">
                    <label>Email Address</label>
                    <InputText class="input"
                               @bind-Value="RequestModel.Email"
                               placeholder="example@eghatha.com" />
                    <ValidationMessage For="() => RequestModel.Email" />
                </div>

                <button class="primary-btn" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="spinner"></span><span>Sending…</span>
                    }
                    else
                    {
                        <span>Send Verification Code →</span>
                    }
                </button>

                <button type="button" class="already-have-code-link" @onclick="SkipToStep2">
                    Already have a code?
                </button>

            </EditForm>
        }

        <!-- Step 2: Code + Passwords -->
        @if (CurrentStep == 2)
        {
            <EditForm Model="@ResetModel" OnValidSubmit="ResetPassword" class="reset-form">
                <DataAnnotationsValidator />

                <div class="field">
                    <div class="field-label-row">
                        <label>Verification Code</label>
                        <button type="button" class="resend-btn" @onclick="ResendCode" disabled="@IsLoading">
                            ↺ Resend Code
                        </button>
                    </div>
                    <InputText class="input code-input"
                               maxlength="8"
                               @bind-Value="ResetModel.Code"
                               placeholder="• • • • • • • •" />
                </div>

                <div class="field">
                    <label>New Password</label>
                    <div class="pw-wrapper">
                        <InputText type="@(ShowNewPassword ? "text" : "password")"
                                   class="input"
                                   @bind-Value="ResetModel.NewPassword" />
                        <button type="button" class="pw-toggle" @onclick="() => ShowNewPassword = !ShowNewPassword">
                            @(ShowNewPassword ? "Hide" : "Show")
                        </button>
                    </div>
                </div>

                <div class="field">
                    <label>Confirm Password</label>
                    <div class="pw-wrapper">
                        <InputText type="@(ShowConfirmPassword ? "text" : "password")"
                                   class="input"
                                   @bind-Value="ConfirmPassword" />
                        <button type="button" class="pw-toggle" @onclick="() => ShowConfirmPassword = !ShowConfirmPassword">
                            @(ShowConfirmPassword ? "Hide" : "Show")
                        </button>
                    </div>
                </div>

                <button class="primary-btn" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="spinner"></span><span>Resetting…</span>
                    }
                    else
                    {
                        <span>Reset Password →</span>
                    }
                </button>
            </EditForm>
        }

        <!-- Step 3: Success -->
        @if (CurrentStep == 3)
        {
            <div class="success-state">
                <div class="success-icon">✓</div>
                <h2>Password Updated</h2>
                <p>Your password has been changed successfully. You can now sign in with your new password.</p>
                <button class="primary-btn" @onclick="GoToLogin">Return to Login</button>
            </div>
        }

        <!-- Error -->
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="error-banner">⚠ @Error</div>
        }

        <a href="/login" class="back-link">← Back to Login</a>

    </div>
</div>

@code {
    private int CurrentStep = 1;
    private string Error = "";
    private string ConfirmPassword = "";
    private bool IsLoading = false;
    private bool ShowNewPassword = false;
    private bool ShowConfirmPassword = false;

    private RequestResetModel RequestModel = new();
    private ResetPasswordRequest ResetModel = new();

    private async Task SendResetCode()
    {
        Error = "";
        IsLoading = true;
        StateHasChanged();

        var result = await ServiceApi.RequestPasswordResetAsync(RequestModel);

        IsLoading = false;

        if (result.IsSuccess)
        {
            ResetModel.Email = RequestModel.Email;
            CurrentStep = 2;
        }
        else
        {
            Error = result.ErrorDetail;
        }

        StateHasChanged();
    }

    // User clicks "I already have a code" — skip straight to step 2
    private void SkipToStep2()
    {
        Error = "";
       
        ResetModel.Email = RequestModel.Email;
        CurrentStep = 2;
        StateHasChanged();
    }

    private async Task ResendCode()
    {
        Error = "";
        IsLoading = true;
        StateHasChanged();

        var result = await ServiceApi.RequestPasswordResetAsync(RequestModel);

        IsLoading = false;

        if (!result.IsSuccess)
        {
            Error = result.ErrorDetail;
        }

        StateHasChanged();
    }

    private async Task ResetPassword()
    {
        Error = "";

        if (ConfirmPassword != ResetModel.NewPassword)
        {
            Error = "Passwords do not match.";
            StateHasChanged();
            return;
        }

        IsLoading = true;
        StateHasChanged();

        var result = await ServiceApi.ResetPasswordAsync(ResetModel);

        IsLoading = false;

        if (result.IsSuccess) CurrentStep = 3;
        else Error = result.ErrorDetail;

        StateHasChanged();
    }

    private void GoToLogin() => Navigation.NavigateTo("/login");
}
