@page "/"
@layout EmptyLayout
@inject IJSRuntime JS

<div class="home-root" data-theme="@(_isDark ? "dark" : "light")">

    <!-- ═══ HERO ═══ -->
    <header class="hero">
        <div class="hero-bg-grid"></div>
        <div class="hero-glow"></div>

        <nav class="top-nav">
            <div class="nav-brand">
                <span class="brand-icon"><i class="fa-solid fa-shield-halved"></i></span>
                <span class="brand-name">DERS</span>
                <span class="brand-tag">Syria Disaster Response</span>
            </div>
            <div class="nav-links">
                <a href="/volunteer/register" class="nav-link">
                    <i class="fa-solid fa-user-plus"></i> Volunteer
                </a>
                <a href="/login" class="nav-link nav-link-outline">
                    <i class="fa-solid fa-right-to-bracket"></i> Login
                </a>
                <button class="nav-theme-btn" @onclick="ToggleTheme"
                        title="@(_isDark ? "Switch to light mode" : "Switch to dark mode")">
                    <i class="fa-solid @(_isDark ? "fa-sun" : "fa-moon")"></i>
                </button>
            </div>
        </nav>

        <div class="hero-content">
            <div class="hero-eyebrow">
                <span class="pulse-dot"></span>
                Operational — Syria-wide coverage
            </div>
            <h1 class="hero-title">
                Every Second<br />
                <span class="hero-title-accent">Counts.</span>
            </h1>
            <p class="hero-subtitle">
                A unified platform for reporting, tracking, and coordinating
                disaster response across all Syrian provinces — in real time.
            </p>
            <div class="hero-actions">
                <a href="/report-disaster" class="btn-hero btn-hero-primary">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Report a Disaster
                </a>
                <a href="/volunteer/register" class="btn-hero btn-hero-ghost">
                    <i class="fa-solid fa-hands-helping"></i>
                    Become a Volunteer
                </a>
            </div>
        </div>

        <div class="hero-stats">
            <div class="stat-item">
                <span class="stat-number">14</span>
                <span class="stat-label">Provinces Covered</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <span class="stat-number">24/7</span>
                <span class="stat-label">Response Monitoring</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <span class="stat-number">&lt; 15 min</span>
                <span class="stat-label">Avg. Alert Time</span>
            </div>
        </div>
    </header>

    <!-- ═══ HOW IT WORKS ═══ -->
    <section class="section section-how">
        <div class="section-inner">
            <div class="section-label">How it works</div>
            <h2 class="section-title">From incident to response<br />in three steps</h2>

            <div class="steps-grid">
                <div class="step-card">
                    <div class="step-icon step-icon-report">
                        <i class="fa-solid fa-tower-broadcast"></i>
                    </div>
                    <div class="step-body">
                        <h3 class="step-title">Report</h3>
                        <p class="step-desc">
                            Anyone in Syria can submit an incident — flood, earthquake,
                            fire, or civil emergency — with location, photos, and details.
                            No account required.
                        </p>
                    </div>
                </div>

                <div class="step-arrow"><i class="fa-solid fa-arrow-right"></i></div>

                <div class="step-card">
                    <div class="step-icon step-icon-track">
                        <i class="fa-solid fa-satellite-dish"></i>
                    </div>
                    <div class="step-body">
                        <h3 class="step-title">Track</h3>
                        <p class="step-desc">
                            Admins verify, prioritise, and update every report. Status
                            flows from <em>Reported</em> → <em>In Progress</em> → <em>Resolved</em>
                            so nothing falls through the cracks.
                        </p>
                    </div>
                </div>

                <div class="step-arrow"><i class="fa-solid fa-arrow-right"></i></div>

                <div class="step-card">
                    <div class="step-icon step-icon-respond">
                        <i class="fa-solid fa-people-carry-box"></i>
                    </div>
                    <div class="step-body">
                        <h3 class="step-title">Respond</h3>
                        <p class="step-desc">
                            Registered volunteers are assigned to active incidents.
                            Coordinators monitor resources, teams, and outcomes on a
                            live dashboard.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══ DISASTER TYPES ═══ -->
    <section class="section section-types">
        <div class="section-inner">
            <div class="section-label">What we track</div>
            <h2 class="section-title">Every kind of emergency</h2>
            <div class="types-grid">
                <div class="type-card">
                    <i class="fa-solid fa-fire type-icon" style="color:#ff7c43"></i>
                    <span>Fires</span>
                </div>
                <div class="type-card">
                    <i class="fa-solid fa-house-crack type-icon" style="color:#ffa600"></i>
                    <span>Earthquakes</span>
                </div>
                <div class="type-card">
                    <i class="fa-solid fa-droplet type-icon" style="color:#3b82f6"></i>
                    <span>Floods</span>
                </div>
                <div class="type-card">
                    <i class="fa-solid fa-wind type-icon" style="color:#a78bfa"></i>
                    <span>Storms</span>
                </div>
                <div class="type-card">
                    <i class="fa-solid fa-biohazard type-icon" style="color:#52c41a"></i>
                    <span>Hazmat</span>
                </div>
                <div class="type-card">
                    <i class="fa-solid fa-person-falling type-icon" style="color:#fb923c"></i>
                    <span>Casualties</span>
                </div>
                <div class="type-card">
                    <i class="fa-solid fa-building-circle-exclamation type-icon" style="color:#f472b6"></i>
                    <span>Infrastructure</span>
                </div>
                <div class="type-card">
                    <i class="fa-solid fa-circle-exclamation type-icon" style="color:#faad14"></i>
                    <span>Other</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══ CTA STRIP ═══ -->
    <section class="cta-strip">
        <div class="cta-inner">
            <div class="cta-text">
                <h2 class="cta-title">Witnessing an emergency?</h2>
                <p class="cta-sub">Submit a report now — no login required.</p>
            </div>
            <a href="/report-disaster" class="btn-hero btn-hero-primary btn-hero-lg">
                <i class="fa-solid fa-triangle-exclamation"></i>
                Report a Disaster
            </a>
        </div>
    </section>

    <!-- ═══ VOLUNTEER BAND ═══ -->
    <section class="section section-volunteer">
        <div class="section-inner volunteer-inner">
            <div class="volunteer-copy">
                <div class="section-label">Join the network</div>
                <h2 class="section-title">Volunteers are the backbone<br />of disaster response.</h2>
                <p class="volunteer-desc">
                    Register as a volunteer to be mobilised when incidents occur in your
                    area. Your skills, your location, your availability — all matched to
                    where they're needed most.
                </p>
                <a href="/volunteer/register" class="btn-hero btn-hero-primary" style="align-self:flex-start">
                    <i class="fa-solid fa-user-plus"></i>
                    Register as Volunteer
                </a>
            </div>
            <div class="volunteer-badges">
                <div class="vbadge"><i class="fa-solid fa-kit-medical"></i> First Aid</div>
                <div class="vbadge"><i class="fa-solid fa-truck-medical"></i> Logistics</div>
                <div class="vbadge"><i class="fa-solid fa-walkie-talkie"></i> Communications</div>
                <div class="vbadge"><i class="fa-solid fa-person-digging"></i> Search & Rescue</div>
                <div class="vbadge"><i class="fa-solid fa-utensils"></i> Food & Aid</div>
                <div class="vbadge"><i class="fa-solid fa-house-chimney-medical"></i> Shelter</div>
                <div class="vbadge"><i class="fa-solid fa-brain"></i> Mental Health</div>
                <div class="vbadge"><i class="fa-solid fa-language"></i> Translation</div>
            </div>
        </div>
    </section>

    <!-- ═══ FOOTER ═══ -->
    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-brand">
                <span class="brand-icon brand-icon-sm"><i class="fa-solid fa-shield-halved"></i></span>
                <span class="brand-name">DERS</span>
            </div>
            <p class="footer-copy">Disaster Emergency Response System — Syria</p>
            <div class="footer-links">
                <a href="/report-disaster" class="footer-link">Report Disaster</a>
                <a href="/volunteer/register" class="footer-link">Volunteer</a>
                <a href="/login" class="footer-link">Login</a>
            </div>
        </div>
    </footer>

</div>

@code {
    private bool _isDark = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var saved = await JS.InvokeAsync<string>("DersTheme.getSaved");
            _isDark = saved != "light";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("DersTheme.apply", _isDark ? "dark" : "light");
    }
}
